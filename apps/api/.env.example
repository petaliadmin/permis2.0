# Database
DATABASE_URL=postgresql://user:password@localhost:5432/permis2.0

# JWT (min 16 chars — validated at startup)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# Server
NODE_ENV=development
PORT=3001

# Frontend
FRONTEND_URL=http://localhost:3000
WEB_URL=http://localhost:3000

# SMS / WhatsApp via Termii (termii.com)
# Leave empty in dev — the OTP is returned in the response as devCode
TERMII_API_KEY=
TERMII_SENDER_ID=PERMIS

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@permis2.com

# ─── Payments (Bictorys) ─────────────────────────────────────────────────────
# DEV  → PAYMENT_LIVE=false : offline sandbox
# PROD → PAYMENT_LIVE=true  : real Bictorys charges (Orange Money, Wave, Free Money, Carte)
PAYMENT_LIVE=false
# dev/test: https://api.test.bictorys.com | production: https://api.bictorys.com
BICTORYS_API_URL=https://api.test.bictorys.com
BICTORYS_API_KEY=
BICTORYS_SECRET_KEY=
PAYMENT_COUNTRY=SN
