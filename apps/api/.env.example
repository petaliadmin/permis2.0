# Database
DATABASE_URL=postgresql://user:password@localhost:5432/permis2.0

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRATION=24h

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Frontend
FRONTEND_URL=http://localhost:3000

# SMS / WhatsApp via Termii (termii.com)
# Create an account at https://termii.com and get your API key from the dashboard.
# Leave empty in development — the OTP code will be returned in the API response as devCode.
TERMII_API_KEY=
# Sender ID registered in your Termii account (e.g. PERMIS or your brand name, max 11 chars)
TERMII_SENDER_ID=PERMIS

# Payments (Bictorys)
# PAYMENT_LIVE=false -> offline sandbox (dev confirm button). true -> real Bictorys charges.
PAYMENT_LIVE=false
# Test base: https://api.test.bictorys.com  | Prod base: https://api.bictorys.com
BICTORYS_API_URL=https://api.test.bictorys.com
# From the Bictorys dashboard (test keys while PAYMENT_LIVE points at the test URL)
BICTORYS_API_KEY=
# Webhook shared secret; compared to the X-Secret-Key header on POST /shop/webhook/bictorys
BICTORYS_SECRET_KEY=
# ISO country for charges (SN = Senegal)
PAYMENT_COUNTRY=SN
