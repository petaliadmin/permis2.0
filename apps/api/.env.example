# Database
DATABASE_URL=postgresql://user:password@localhost:5432/permis2.0

# JWT (min 16 chars — validated at startup)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# Server
NODE_ENV=development
PORT=3001
# DANGER — account-takeover surface, see the comment on verifyOtp in
# auth.service.ts. Only set to true in production as a stopgap while
# DExchange SMS/WhatsApp delivery isn't confirmed working end to end, and
# unset it (or set false) the moment it is. Always bypassed outside
# production regardless of this flag (dev/test convenience).
OTP_BYPASS=false

# Frontend
FRONTEND_URL=http://localhost:3000
WEB_URL=http://localhost:3000

# SMS / WhatsApp via DExchange (dexchange-sms.com)
# Leave empty in dev — the OTP is logged to the server console instead
DEXCHANGE_API_KEY=
# "DEXCHANGE" is pre-validated and needs no approval. Ask DExchange to approve
# a custom signature (e.g. PERMIS, max 11 chars) from your dashboard, then set it here.
DEXCHANGE_SMS_SENDER=DEXCHANGE
# WhatsApp needs a phone number connected once via QR code from the DExchange
# dashboard (Whatsapp Web bridge, not the Meta Business API) — until it's
# connected, "whatsapp" sends fall back to SMS automatically.

# Transactional email (invoices/devis) via plain SMTP (nodemailer)
# Leave SMTP_HOST empty in dev — the email is logged to the server console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@permis2.com
SMTP_FROM_NAME=PERMIS 2.0

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@permis2.com

# ─── Payments (Bictorys) ─────────────────────────────────────────────────────
# DEV  → PAYMENT_LIVE=false : offline sandbox
# PROD → PAYMENT_LIVE=true  : real Bictorys charges (Orange Money, Wave, Free Money, Carte)
PAYMENT_LIVE=false
# dev/test: https://api.test.bictorys.com | production: https://api.bictorys.com
BICTORYS_API_URL=https://api.test.bictorys.com
BICTORYS_API_KEY=
BICTORYS_SECRET_KEY=
PAYMENT_COUNTRY=SN
