// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProfileType {
  PARTICULIER
  AUTO_ECOLE
}

// ─── Multi-tenant : auto-écoles — Phase 0 fondations ─────────────────────────

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SchoolMemberRole {
  OWNER
  MANAGER
  SECRETARY
  INSTRUCTOR
  COACH
  ACCOUNTANT
}

enum SchoolEnrollmentStatus {
  SENT
  IN_PROGRESS
  ACCEPTED
  REFUSED
  CONFIRMED
}

enum SchoolStudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum SessionType {
  THEORY
  PRACTICE
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SchoolPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum SchoolPaymentType {
  DEVIS
  FACTURE
}

model User {
  id           String      @id @default(cuid())
  email        String?     @unique
  phone        String?     @unique
  name         String
  avatar       String?
  passwordHash String?
  pinHash      String?
  xp           Int         @default(0)
  level        String      @default("Débutant")
  role         Role        @default(USER)
  profileType  ProfileType @default(PARTICULIER)
  blocked      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  exams               Exam[]
  progress            Progress[]
  statistics          Statistic[]
  favorites           Favorite[]
  badges              Badge[]
  streak              DailyStreak?
  subscriptions       Subscription[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  entitlements        Entitlement[]
  purchases           Purchase[]

  // Multi-tenant — Phase 0 fondations (relations virtuelles, aucune colonne ajoutée sur users)
  schoolMemberships           SchoolMembership[]
  schoolStudentLinks          SchoolStudent[]
  schoolEnrollmentRequests    SchoolEnrollmentRequest[] @relation("SchoolEnrollmentRequestStudent")
  respondedEnrollmentRequests SchoolEnrollmentRequest[] @relation("SchoolEnrollmentRequestResponder")
  schoolReviews               SchoolReview[]

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  label       String
  description String
  couleur     String
  icone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lessons    Lesson[]
  questions  Question[]
  statistics Statistic[]

  @@map("categories")
}

model Lesson {
  id                 String   @id @default(cuid())
  categoryId         String
  titre              String
  contenu            String
  points_cles        String[]
  exceptions         String[]
  erreurs_frequentes String[]
  regles             String[]
  illustrations      String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@index([categoryId])
  @@map("lessons")
}

model Series {
  id          String   @id @default(cuid())
  name        String
  description String
  code        String   @unique // B1, B2, B3
  isFree      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  questions Question[]
  progress  Progress[]

  @@map("series")
}

model Question {
  id                    String   @id @default(cuid())
  serieId               String
  categoryId            String
  numero                Int
  enonce                String
  image                 String? // e.g. /icons/panneaux/{code}.svg (quiz) or /data/diapos/{serie}_q{n}.webp (diapo exam)
  signalisation_visible String?
  reponses_correctes    String[]
  explication           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  series        Series         @relation(fields: [serieId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  choices       Choice[]
  examQuestions ExamQuestion[]
  favorites     Favorite[]

  @@index([serieId])
  @@index([categoryId])
  @@map("questions")
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  text       String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("choices")
}

model Exam {
  id          String    @id @default(cuid())
  userId      String
  status      String    @default("pending") // pending, in_progress, completed
  duration    Int       @default(1800000) // 30 minutes in milliseconds
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  result    ExamResult?

  @@index([userId])
  @@map("exams")
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  questionId String
  userAnswer String?
  isCorrect  Boolean?
  timeSpent  Int      @default(0) // in seconds
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([questionId])
  @@map("exam_questions")
}

model ExamResult {
  id          String   @id @default(cuid())
  examId      String   @unique
  userId      String
  score       Int
  percentage  Int
  passed      Boolean
  timeUsed    Int // in seconds
  totalTime   Int // in seconds
  startedAt   DateTime
  completedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([userId])
  @@index([userId, completedAt])
  @@map("exam_results")
}

model Progress {
  id             String   @id @default(cuid())
  userId         String
  serieId        String
  correctAnswers Int      @default(0)
  totalQuestions Int      @default(0)
  accuracy       Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [serieId], references: [id], onDelete: Cascade)

  @@unique([userId, serieId])
  @@index([userId])
  @@index([serieId])
  @@map("progress")
}

model Statistic {
  id             String   @id @default(cuid())
  userId         String
  categoryId     String?
  correctAnswers Int      @default(0)
  totalAnswers   Int      @default(0)
  successRate    Float    @default(0)
  averageTime    Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@map("statistics")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String?
  questionId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, questionId])
  @@index([userId])
  @@index([lessonId])
  @@index([questionId])
  @@map("favorites")
}

model Badge {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String
  icon        String
  unlockedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("badges")
}

model DailyStreak {
  id               String    @id @default(cuid())
  userId           String    @unique
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_streaks")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // success, info, warning, error
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  plan      String    @default("free") // free, premium, pro
  status    String    @default("active") // active, cancelled, expired
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model TrafficSign {
  id             String   @id @default(cuid())
  name           String
  code           String?
  meaning        String
  category       String // Danger, Interdiction, Obligation, Priorité, Indication, Direction, Temporaire, Restriction, Stationnement
  description    String
  contexte_usage String?
  regle_associee String?
  advice         String[] @default([])
  ordre          Int      @default(0)
  icone          String?
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([name])
  @@map("traffic_signs")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Entitlement {
  id         String    @id @default(cuid())
  userId     String
  key        String
  source     String    @default("purchase")
  purchaseId String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("entitlements")
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  title        String
  description  String?
  kind         String
  priceXof     Int
  active       Boolean  @default(true)
  ordre        Int      @default(0)
  grants       String[]
  validityDays Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases Purchase[]

  @@map("products")
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  /// Set only for school-scoped products (school_subscription, featured_placement) —
  /// which School the purchase applies to. Null for individual (student) products.
  schoolId    String?
  provider    String
  method      String?
  phone       String?
  amountXof   Int
  status      String   @default("PENDING")
  providerRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  school  School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@unique([providerRef])
  @@index([userId])
  @@index([schoolId])
  @@map("purchases")
}

model DrivingCourse {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  ordre       Int      @default(0)
  isDraft     Boolean  @default(false)
  isFree      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions DrivingQuestion[]

  @@map("driving_courses")
}

model DrivingQuestion {
  id                 String   @id @default(cuid())
  courseId           String
  numero             Int
  enonce             String
  image              String?
  reponses_correctes String[]
  explication        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course  DrivingCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  choices DrivingChoice[]

  @@index([courseId])
  @@map("driving_questions")
}

model DrivingChoice {
  id         String   @id @default(cuid())
  questionId String
  text       String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question DrivingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("driving_choices")
}

model OtpToken {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  channel   String    @default("sms")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
  @@index([phone, expiresAt])
  @@map("otp_tokens")
}

model SmsLog {
  id        String   @id @default(cuid())
  phone     String
  channel   String   @default("sms")
  simulated Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("sms_logs")
}

/// Image-based mock-exam series (diapos) — content served to the web app.
model DiapoExam {
  id        Int      @id
  title     String
  questions Json
  updatedAt DateTime @updatedAt

  @@map("diapo_exams")
}

// ─── Multi-tenant : auto-écoles — Phase 0 fondations ─────────────────────────

/// A driving school (tenant). Data belonging to a school must always be
/// scoped by schoolId — see SchoolRolesGuard for the enforcement mechanism.
model School {
  id     String       @id @default(cuid())
  slug   String       @unique
  name   String
  status SchoolStatus @default(PENDING)

  city              String?
  district          String?
  address           String?
  /// Free-form paragraph the school writes about itself (SEO brief Lot
  /// 3.3 — "paragraphe descriptif unique"), shown on its public fiche and
  /// fed into DrivingSchool.description. Owner-editable, same trust model
  /// as every other field here — never auto-generated or templated.
  description       String?
  phone             String?
  whatsapp          String?
  email             String?
  logoUrl           String?
  openingHours      Json?
  services          String[] @default([])
  licenseCategories String[] @default([])
  /// Starting price shown on cards/search — kept in sync with the minimum
  /// value of `pricesByCategory` server-side, never edited directly once
  /// per-category pricing is set. See SchoolService.update().
  priceXof          Int?
  /// Per-category price in FCFA, e.g. { "A": 80000, "B": 150000 }. Keys are
  /// `licenseCategories` codes. Optional — a school can still expose only the
  /// single `priceXof` (legacy/simple pricing) until they fill this in.
  pricesByCategory  Json?

  /// Platform access gate: the school's staff can use /mon-ecole only while this
  /// is in the future. Set to createdAt + 3 months at creation (free trial),
  /// then extended by a PAID school_subscription Purchase (see
  /// ShopService.markPaid) — enforced centrally in SchoolRolesGuard.
  subscriptionExpiresAt DateTime?
  /// End of the one-time free trial, set once at creation and never touched
  /// again (unlike subscriptionExpiresAt, which purchases extend). Lets the
  /// frontend tell "still in/just finished the free trial" apart from "paid
  /// subscription active/expired": subscriptionExpiresAt === trialEndsAt means
  /// no purchase has ever extended past the original trial.
  trialEndsAt           DateTime?
  /// While in the future, the school appears in the homepage "Top 20" list.
  /// Extended by a PAID featured_placement Purchase.
  featuredUntil         DateTime?

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        SchoolMembership[]
  enrollmentRequests SchoolEnrollmentRequest[]
  students           SchoolStudent[]
  vehicles           Vehicle[]
  sessions           Session[]
  payments           SchoolPayment[]
  purchases          Purchase[]
  reviews            SchoolReview[]

  @@index([status])
  @@index([city])
  @@map("schools")
}

/// Public review — Lot 5 (SEO brief). Any authenticated PERMIS2.0 user may
/// leave one review per school (unique constraint below), published
/// immediately, no moderation queue — a deliberate product choice, not an
/// oversight (see SEO brief follow-up). One row per (school, user) — a
/// second POST updates the existing review rather than creating a
/// duplicate, so a rating can't be inflated by resubmitting.
model SchoolReview {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@map("school_reviews")
}

/// Staff rattachement to a school with a scoped role (RBAC tenant axis).
/// The school owner is modeled ONLY via a membership row (role = OWNER),
/// never via a denormalized column on School, to avoid two sources of truth.
model SchoolMembership {
  id        String           @id @default(cuid())
  schoolId  String
  userId    String?
  /// Set only when userId is null — a staff member added without a PERMIS 2.0
  /// account yet. Cleared (and userId filled in) once they register with a
  /// matching phone — see AuthService.linkGuestSchoolRows.
  guestName  String?
  guestPhone String?
  role      SchoolMemberRole
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedStudents SchoolStudent[]
  sessions         Session[]

  @@unique([schoolId, userId, role])
  @@index([schoolId])
  @@index([userId])
  @@index([guestPhone])
  @@map("school_memberships")
}

/// A pre-registration lead submitted for a school. Separate from SchoolStudent
/// on purpose: this is a CRM/workflow object (statuses SENT..REFUSED stop
/// mattering once confirmed) while SchoolStudent is the durable operational
/// rattachement — mirrors the existing Purchase -> Entitlement split.
model SchoolEnrollmentRequest {
  id                String                 @id @default(cuid())
  schoolId          String
  studentUserId     String?
  firstName         String
  lastName          String
  phone             String
  whatsapp          String?
  email             String?
  city              String?
  licenseCategory   String?
  message           String?
  status            SchoolEnrollmentStatus @default(SENT)
  statusNote        String?
  respondedByUserId String?
  respondedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentUser User?          @relation("SchoolEnrollmentRequestStudent", fields: [studentUserId], references: [id])
  respondedBy User?          @relation("SchoolEnrollmentRequestResponder", fields: [respondedByUserId], references: [id])
  studentLink SchoolStudent?

  @@index([schoolId, status])
  @@index([studentUserId])
  @@map("school_enrollment_requests")
}

/// Confirmed student <-> school rattachement. Kept separate from
/// SchoolEnrollmentRequest so every future ERP module (planning, finances,
/// exams) can query "students of this school" without re-filtering by status.
model SchoolStudent {
  id                             String              @id @default(cuid())
  schoolId                       String
  userId                         String?
  /// Set only when userId is null — a student added without a PERMIS 2.0
  /// account yet (manual add, contact import, CSV/Excel import). Cleared
  /// (and userId filled in) once they register with a matching phone.
  guestName                      String?
  guestPhone                     String?
  enrollmentRequestId            String?             @unique
  licenseCategory                String?
  status                         SchoolStudentStatus @default(ACTIVE)
  enrolledAt                     DateTime            @default(now())
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
  assignedInstructorMembershipId String?
  assignedVehicleId              String?

  school             School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentRequest  SchoolEnrollmentRequest? @relation(fields: [enrollmentRequestId], references: [id])
  assignedInstructor SchoolMembership?        @relation(fields: [assignedInstructorMembershipId], references: [id], onDelete: SetNull)
  assignedVehicle    Vehicle?                 @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  sessions           Session[]
  payments           SchoolPayment[]

  @@unique([schoolId, userId])
  @@index([schoolId, status])
  @@index([userId])
  @@index([guestPhone])
  @@map("school_students")
}

/// A vehicle in a school's fleet. Hard-deletable (unlike staff/students) —
/// removing it from inventory needs no historical trace elsewhere.
model Vehicle {
  id                           String        @id @default(cuid())
  schoolId                     String
  plate                        String
  brand                        String?
  model                        String?
  category                     String?
  status                       VehicleStatus @default(ACTIVE)
  insuranceExpiresAt           DateTime?
  technicalInspectionExpiresAt DateTime?
  notes                        String?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  assignedStudents SchoolStudent[]
  sessions         Session[]

  @@unique([schoolId, plate])
  @@index([schoolId, status])
  @@map("vehicles")
}

/// A theory/practice session for a student. No hard delete — like enrollment
/// requests/students, a session has historical value (statuses reflect its
/// outcome: COMPLETED/CANCELLED/NO_SHOW) rather than being erased.
model Session {
  id                     String        @id @default(cuid())
  schoolId               String
  studentId              String
  type                   SessionType   @default(PRACTICE)
  status                 SessionStatus @default(SCHEDULED)
  startsAt               DateTime
  endsAt                 DateTime
  instructorMembershipId String?
  vehicleId              String?
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    SchoolStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructor SchoolMembership? @relation(fields: [instructorMembershipId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([schoolId, startsAt])
  @@index([studentId, startsAt])
  @@map("sessions")
}

/// A manual invoice/payment record — tracked by staff, not a payment gateway
/// integration (Mobile Money gateway integration is a later phase). Mirrors
/// the existing "manual" purchase pattern already used by ShopService.
model SchoolPayment {
  id          String              @id @default(cuid())
  schoolId    String
  studentId   String
  type        SchoolPaymentType   @default(FACTURE)
  /// Sequential per-school, per-type, per-year reference (e.g. "F-2026-0001",
  /// "D-2026-0001"), generated server-side in SchoolService.createPayment.
  number      String?
  amountXof   Int
  description String
  /// Line items ({ label, qty, unitPriceXof }[]) backing amountXof. Optional
  /// so older rows (created before line items existed) stay valid.
  items       Json?
  notes       String?
  status      SchoolPaymentStatus @default(PENDING)
  method      String?
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentId, status])
  @@map("school_payments")
}

/// Admin-editable reference price per ville × catégorie de permis, shown on
/// /prix-permis-conduire-senegal (SEO brief Lot 4.1). Deliberately not
/// sourced from School.priceXof/pricesByCategory (partner-specific, one
/// price per school) — this is the *reference* table editors maintain by
/// hand for the market-comparison page, independent of any one partner's
/// listing. Empty until an admin fills it in; the page must never show
/// invented figures (brief rule 1).
model PermitPrice {
  id       String @id @default(cuid())
  city     String
  /// License category code (A, B, C, D, E…) — same codes as
  /// School.licenseCategories.
  category String
  priceXof Int
  /// Optional context shown next to the price, e.g. "Code + conduite".
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([city, category])
  @@index([city])
  @@map("permit_prices")
}
