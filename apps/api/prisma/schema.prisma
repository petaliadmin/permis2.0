// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String     @id @default(cuid())
  email         String?    @unique
  phone         String?    @unique
  name          String
  avatar        String?
  passwordHash  String?
  pinHash       String?
  xp            Int        @default(0)
  level         String     @default("Débutant")
  role          Role       @default(USER)
  blocked       Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  exams               Exam[]
  progress            Progress[]
  statistics          Statistic[]
  favorites           Favorite[]
  badges              Badge[]
  streak              DailyStreak?
  subscriptions       Subscription[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  entitlements        Entitlement[]
  purchases           Purchase[]

  @@map("users")
}

model Category {
  id          String     @id @default(cuid())
  label       String
  description String
  couleur     String
  icone       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  lessons     Lesson[]
  questions   Question[]
  statistics  Statistic[]

  @@map("categories")
}

model Lesson {
  id                  String     @id @default(cuid())
  categoryId          String
  titre               String
  contenu             String
  points_cles         String[]
  exceptions          String[]
  erreurs_frequentes  String[]
  regles              String[]
  illustrations       String[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  category            Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  favorites           Favorite[]

  @@index([categoryId])
  @@map("lessons")
}

model Series {
  id          String     @id @default(cuid())
  name        String
  description String
  code        String     @unique // B1, B2, B3
  isFree      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  questions   Question[]
  progress    Progress[]

  @@map("series")
}

model Question {
  id                    String     @id @default(cuid())
  serieId               String
  categoryId            String
  numero                Int
  enonce                String
  image                 String?    // e.g. /icons/panneaux/{code}.svg (quiz) or /data/diapos/{serie}_q{n}.webp (diapo exam)
  signalisation_visible String?
  reponses_correctes    String[]
  explication           String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Relations
  series                Series     @relation(fields: [serieId], references: [id], onDelete: Cascade)
  category              Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  choices               Choice[]
  examQuestions         ExamQuestion[]
  favorites             Favorite[]

  @@index([serieId])
  @@index([categoryId])
  @@map("questions")
}

model Choice {
  id          String     @id @default(cuid())
  questionId  String
  text        String
  order       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("choices")
}

model Exam {
  id          String     @id @default(cuid())
  userId      String
  status      String     @default("pending") // pending, in_progress, completed
  duration    Int        @default(1800000) // 30 minutes in milliseconds
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   ExamQuestion[]
  result      ExamResult?

  @@index([userId])
  @@map("exams")
}

model ExamQuestion {
  id          String     @id @default(cuid())
  examId      String
  questionId  String
  userAnswer  String?
  isCorrect   Boolean?
  timeSpent   Int        @default(0) // in seconds
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([questionId])
  @@map("exam_questions")
}

model ExamResult {
  id          String     @id @default(cuid())
  examId      String     @unique
  userId      String
  score       Int
  percentage  Int
  passed      Boolean
  timeUsed    Int        // in seconds
  totalTime   Int        // in seconds
  startedAt   DateTime
  completedAt DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([userId])
  @@index([userId, completedAt])
  @@map("exam_results")
}

model Progress {
  id              String     @id @default(cuid())
  userId          String
  serieId         String
  correctAnswers  Int        @default(0)
  totalQuestions  Int        @default(0)
  accuracy        Float      @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  series          Series     @relation(fields: [serieId], references: [id], onDelete: Cascade)

  @@unique([userId, serieId])
  @@index([userId])
  @@index([serieId])
  @@map("progress")
}

model Statistic {
  id              String     @id @default(cuid())
  userId          String
  categoryId      String?
  correctAnswers  Int        @default(0)
  totalAnswers    Int        @default(0)
  successRate     Float      @default(0)
  averageTime     Float      @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
  @@unique([userId, categoryId])
  @@map("statistics")
}

model Favorite {
  id          String     @id @default(cuid())
  userId      String
  lessonId    String?
  questionId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question    Question?  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, questionId])
  @@index([userId])
  @@index([lessonId])
  @@index([questionId])
  @@map("favorites")
}

model Badge {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String
  icon        String
  unlockedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("badges")
}

model DailyStreak {
  id              String     @id @default(cuid())
  userId          String     @unique
  currentStreak   Int        @default(0)
  longestStreak   Int        @default(0)
  lastActivityDate DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_streaks")
}

model Notification {
  id        String     @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String     @default("info") // success, info, warning, error
  read      Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Subscription {
  id        String     @id @default(cuid())
  userId    String
  plan      String     @default("free") // free, premium, pro
  status    String     @default("active") // active, cancelled, expired
  startDate DateTime   @default(now())
  endDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model TrafficSign {
  id              String     @id @default(cuid())
  name            String
  code            String?
  meaning         String
  category        String // Danger, Interdiction, Obligation, Priorité, Indication, Direction, Temporaire, Restriction, Stationnement
  description     String
  contexte_usage  String?
  regle_associee  String?
  advice          String[]   @default([])
  ordre           Int        @default(0)
  icone           String?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([name])
  @@map("traffic_signs")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Entitlement {
  id         String    @id @default(cuid())
  userId     String
  key        String
  source     String    @default("purchase")
  purchaseId String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("entitlements")
}

model Product {
  id           String     @id @default(cuid())
  sku          String     @unique
  title        String
  description  String?
  kind         String
  priceXof     Int
  active       Boolean    @default(true)
  ordre        Int        @default(0)
  grants       String[]
  validityDays Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  purchases    Purchase[]

  @@map("products")
}

model Purchase {
  id          String    @id @default(cuid())
  userId      String
  productId   String
  provider    String
  method      String?
  phone       String?
  amountXof   Int
  status      String    @default("PENDING")
  providerRef String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@index([userId])
  @@unique([providerRef])
  @@map("purchases")
}

model DrivingCourse {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String?
  ordre       Int               @default(0)
  isDraft     Boolean           @default(false)
  isFree      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  questions   DrivingQuestion[]

  @@map("driving_courses")
}

model DrivingQuestion {
  id                 String          @id @default(cuid())
  courseId           String
  numero             Int
  enonce             String
  image              String?
  reponses_correctes String[]
  explication        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  course             DrivingCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  choices            DrivingChoice[]

  @@index([courseId])
  @@map("driving_questions")
}

model DrivingChoice {
  id         String          @id @default(cuid())
  questionId String
  text       String
  order      Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  question   DrivingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("driving_choices")
}

model OtpToken {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  channel   String    @default("sms")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
  @@index([phone, expiresAt])
  @@map("otp_tokens")
}

model SmsLog {
  id        String   @id @default(cuid())
  phone     String
  channel   String   @default("sms")
  simulated Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("sms_logs")
}

/// Image-based mock-exam series (diapos) — content served to the web app.
model DiapoExam {
  id        Int      @id
  title     String
  questions Json
  updatedAt DateTime @updatedAt

  @@map("diapo_exams")
}
