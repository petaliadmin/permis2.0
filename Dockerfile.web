# ─── Stage 1: builder ───────────────────────────────────────────────────────
FROM node:20-slim AS builder

RUN npm install -g pnpm

WORKDIR /app

COPY package*.json ./
COPY pnpm-workspace.yaml ./
COPY turbo.json ./
COPY tsconfig.json ./
COPY .eslintrc.json ./
COPY .prettierrc.json ./

COPY apps/web ./apps/web
COPY packages ./packages

RUN pnpm install

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time — they
# must be present as build args, not just runtime container env vars, or the
# browser bundle falls back to the http://localhost:3001 default forever.
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG NEXT_PUBLIC_PAYMENT_MODE=manual
ARG NEXT_PUBLIC_PAYMENT_LIVE=false
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_PAYMENT_MODE=${NEXT_PUBLIC_PAYMENT_MODE}
ENV NEXT_PUBLIC_PAYMENT_LIVE=${NEXT_PUBLIC_PAYMENT_LIVE}

# Build the Next.js application — produces .next/standalone with output:'standalone'
RUN pnpm --filter @permis2.0/web run build

# ─── Stage 2: runner (standalone server, no TypeScript needed) ───────────────
FROM node:20-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Standalone output is a self-contained Node server; it needs only the static
# assets layered on top of it.
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

# Non-root user for security
RUN chown -R node:node /app
USER node

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
