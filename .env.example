# Database
DB_USER=permis2.0
DB_PASSWORD=password123
DB_NAME=permis2.0
DATABASE_URL=postgresql://permis2.0:password123@localhost:5432/permis2.0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# SMS / WhatsApp via Termii (termii.com)
# Leave empty in dev — the OTP is returned in the response as devCode
TERMII_API_KEY=
TERMII_SENDER_ID=PERMIS

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@permis2.com

# Storage (Supabase)
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

# Firebase
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# ─── Payments (Bictorys) ────────────────────────────────────────────────────────
# DEV  → PAYMENT_LIVE=false  : offline sandbox
# PROD → PAYMENT_LIVE=true   : real Bictorys charges (Orange Money, Wave, Free Money, Carte)
PAYMENT_LIVE=false
# dev/test: https://api.test.bictorys.com | production: https://api.bictorys.com
BICTORYS_API_URL=https://api.test.bictorys.com
# Your Bictorys API key (https://dashboard.bictorys.com → Settings → API)
BICTORYS_API_KEY=
# Webhook secret (set in Bictorys dashboard → Settings → Webhooks)
BICTORYS_SECRET_KEY=
PAYMENT_COUNTRY=SN
# Mirror for the frontend (hides dev sandbox button in production)
NEXT_PUBLIC_PAYMENT_LIVE=false
# TEMPORAIRE : mode de paiement de la boutique.
#   manual (défaut) → activation par l'équipe via WhatsApp (76 905 58 52)
#   online          → réactive le paiement en ligne Bictorys
NEXT_PUBLIC_PAYMENT_MODE=manual
