# Database
DB_USER=permis2.0
DB_PASSWORD=password123
DB_NAME=permis2.0
DATABASE_URL=postgresql://permis2.0:password123@localhost:5432/permis2.0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Storage (Supabase)
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

# Firebase
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Payments (Bictorys)
# PAYMENT_LIVE=false -> offline sandbox (dev confirm button). true -> real Bictorys charges.
PAYMENT_LIVE=false
# Test base: https://api.test.bictorys.com  | Prod base: https://api.bictorys.com
BICTORYS_API_URL=https://api.test.bictorys.com
# From the Bictorys dashboard (test keys while PAYMENT_LIVE points at the test URL)
BICTORYS_API_KEY=
# Webhook shared secret; compared to the X-Secret-Key header on POST /shop/webhook/bictorys
BICTORYS_SECRET_KEY=
# ISO country for charges (SN = Senegal)
PAYMENT_COUNTRY=SN
# Web: mirror of PAYMENT_LIVE so the boutique hides the dev "simulate" button in live mode
NEXT_PUBLIC_PAYMENT_LIVE=false
