# ─── Stage 1: builder ───────────────────────────────────────────────────────
FROM node:20-slim AS builder

# Only dumb-init and openssl needed - no build tools (using bcryptjs pure JS instead of bcrypt native)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm

WORKDIR /app

COPY package*.json ./
COPY pnpm-workspace.yaml ./
COPY turbo.json ./
COPY tsconfig.json ./
COPY .eslintrc.json ./
COPY .prettierrc.json ./

COPY apps/api ./apps/api
COPY packages ./packages

# Data source JSON files — the Prisma seed resolves them relative to
# dist/prisma (../../../*.json => /app/apps/*.json). Keep them in the image
# so seeding is reproducible without manual copies.
COPY categories_et_meta.json fiches_theoriques.json serie_B1.json serie_B2.json serie_B3.json panneaux_senegal.json conduite.json ./apps/

# sync-content.ts resolves these relative to apps/web/public/data (as if it
# were a full monorepo checkout) even though this image never builds the web
# app — copy just the 3 JSON files it actually reads.
COPY apps/web/public/data/panneaux.json apps/web/public/data/questions_doc.json apps/web/public/data/diapos.json ./apps/web/public/data/

RUN pnpm install
RUN cd apps/api && pnpm run prisma:generate
RUN cd packages/types && pnpm run build
RUN cd packages/utils && pnpm run build
RUN cd apps/api && pnpm run build

# ─── Stage 2: runner ─────────────────────────────────────────────────────────
FROM node:20-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    dumb-init \
    openssl \
    procps \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm

WORKDIR /app

# Copy compiled output and manifests needed for pnpm install --prod
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/pnpm-lock.yaml ./

# Copy data files needed for seed (run manually via docker exec).
# seed.ts resolves them via path.join(dirname(__filename), '../../../*.json')
# from apps/api/prisma/seed.ts (running via ts-node, not compiled dist) — that's
# 3 levels up from apps/api/prisma, i.e. /app/*.json, NOT /app/apps/*.json.
COPY --from=builder /app/apps/categories_et_meta.json /app/
COPY --from=builder /app/apps/fiches_theoriques.json /app/
COPY --from=builder /app/apps/serie_B1.json /app/
COPY --from=builder /app/apps/serie_B2.json /app/
COPY --from=builder /app/apps/serie_B3.json /app/
COPY --from=builder /app/apps/panneaux_senegal.json /app/
COPY --from=builder /app/apps/conduite.json /app/

# sync-content.ts's data source — see matching comment in the builder stage.
COPY --from=builder /app/apps/web/public/data/panneaux.json /app/apps/web/public/data/
COPY --from=builder /app/apps/web/public/data/questions_doc.json /app/apps/web/public/data/
COPY --from=builder /app/apps/web/public/data/diapos.json /app/apps/web/public/data/

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile

# Generate Prisma client for the production schema
RUN cd apps/api && pnpm exec prisma generate

# Non-root user for security
RUN chown -R node:node /app
USER node

WORKDIR /app/apps/api

EXPOSE 3001

ENTRYPOINT ["dumb-init", "--"]
# Migrations must be run manually before startup:
#   docker compose exec api npx prisma migrate deploy
CMD ["node", "dist/src/main.js"]
