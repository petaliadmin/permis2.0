FROM node:20-slim

WORKDIR /app

# Only dumb-init and openssl needed - no build tools (using bcryptjs pure JS instead of bcrypt native)
RUN apt-get update && apt-get install -y --no-install-recommends \
    dumb-init \
    openssl \
    procps \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm

COPY package*.json ./
COPY turbo.json ./
COPY tsconfig.json ./
COPY .eslintrc.json ./
COPY .prettierrc.json ./
COPY pnpm-workspace.yaml ./

COPY apps/api ./apps/api
COPY packages ./packages

# Data source JSON files — the Prisma seed resolves them relative to
# dist/prisma (../../../*.json => /app/apps/*.json). Keep them in the image
# so seeding is reproducible without manual copies.
COPY categories_et_meta.json fiches_theoriques.json serie_B1.json serie_B2.json serie_B3.json panneaux_senegal.json ./apps/

RUN pnpm install && cd apps/api && pnpm run prisma:generate
RUN cd apps/api && pnpm run build

EXPOSE 3001

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/src/main.js"]
