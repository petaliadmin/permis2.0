# Reverse proxy + automatic HTTPS (Let's Encrypt) for permis2.0.
# Deployed alongside docker-compose.aws.yml — see scripts/aws/deploy-remote.sh.
#
# DNS required (A records, all -> the Elastic IP from `terraform output public_ip`):
#   permis2.com, www.permis2.com, api.permis2.com

{
	email admin@permis2.com
}

www.permis2.com {
	encode zstd gzip
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

permis2.com {
	redir https://www.permis2.com{uri} permanent
}

api.permis2.com {
	encode zstd gzip
	reverse_proxy api:3001 {
		# Overwrite rather than append — a client sending its own
		# X-Forwarded-For header must not be able to spoof the IP that
		# NestJS's ThrottlerGuard (see apps/api/src/main.ts trust proxy) uses
		# for per-user rate limiting.
		header_up X-Forwarded-For {http.request.remote.host}
	}
}
