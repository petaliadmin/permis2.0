# Reverse proxy + automatic HTTPS (Let's Encrypt) for permis2.0.
# Deployed alongside docker-compose.aws.yml — see scripts/aws/deploy-remote.sh.
#
# DNS required (A records, all -> the Elastic IP from `terraform output public_ip`):
#   permis2.com, www.permis2.com, api.permis2.com,
#   learn.permis2.com, school.permis2.com, admin.permis2.com
#
# The one Next.js app (web:3000) serves all four front hosts; it reads the
# Host header in middleware to pick the space (see apps/web/src/lib/space.ts).

{
	email admin@permis2.com

	# Lot 1.6 (SEO brief) — loads the cache-handler (Souin) module built into
	# this Caddy image (see ../Dockerfile.caddy). Whether a given response is
	# actually cached is decided by the origin's OWN Cache-Control header
	# (souin is RFC 7234 compliant) — nothing below picks routes by hand.
	# `default_cache_control "no-store"` is the safety net for every route
	# that sends no Cache-Control at all (everything behind auth, everything
	# with live per-request data — i.e. most of the app): souin's own
	# default treats a missing header as cacheable, which would be wrong
	# here. Only the routes apps/web/next.config.ts explicitly marks
	# `public, s-maxage=3600, stale-while-revalidate=86400` (editorial
	# pages, traffic signs, blog) opt in.
	cache {
		default_cache_control "no-store"
	}
}

# ── Front hosts — all proxy to the same Next.js container ──────────────────────
www.permis2.com, learn.permis2.com, school.permis2.com, admin.permis2.com {
	# br (Brotli) — audit finding (Étape 7). Built into stock Caddy, no
	# module needed. Listed by preference: zstd > br > gzip.
	encode zstd br gzip
	# Cache key includes the Host header by default (souin), so sharing this
	# one `cache` across all four spaces is safe: a cached www editorial page
	# never gets served to learn/school/admin, and their own routes stay
	# uncached anyway (none of them send a public Cache-Control header).
	cache
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

permis2.com {
	redir https://www.permis2.com{uri} permanent
}

api.permis2.com {
	encode zstd br gzip
	reverse_proxy api:3001 {
		# Overwrite rather than append — a client sending its own
		# X-Forwarded-For header must not be able to spoof the IP that
		# NestJS's ThrottlerGuard (see apps/api/src/main.ts trust proxy) uses
		# for per-user rate limiting.
		header_up X-Forwarded-For {http.request.remote.host}
	}
}
