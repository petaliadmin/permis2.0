# Copy to .env.aws.prod (git-ignored) and fill in real values, then run:
#   ./scripts/aws/set-secrets.sh
#
# FRONTEND_URL / WEB_URL / NEXT_PUBLIC_API_URL: use your HTTPS domains (see
# Caddyfile + DEPLOY.md section 9). No domain yet? Fall back to the Elastic
# IP (`terraform output public_ip`, infra/aws/) with the plain HTTP ports,
# e.g. http://51.x.x.x:3000 / http://51.x.x.x:3001.

DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-access-token

DB_USER=permis2_0
DB_PASSWORD=changeme-generate-a-long-random-value
DB_NAME=permis2_0

JWT_SECRET=changeme-generate-a-long-random-value
JWT_EXPIRATION=24h

FRONTEND_URL=https://www.permis2.com
WEB_URL=https://www.permis2.com
NEXT_PUBLIC_API_URL=https://api.permis2.com

BREVO_API_KEY=
BREVO_SMS_SENDER=PERMIS
BREVO_WHATSAPP_TEMPLATE_ID=
BREVO_WHATSAPP_SENDER_NUMBER=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@permis2.com

PAYMENT_LIVE=false
BICTORYS_API_URL=https://api.bictorys.com
BICTORYS_API_KEY=
BICTORYS_SECRET_KEY=
PAYMENT_COUNTRY=SN
