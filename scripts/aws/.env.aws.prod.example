# Copy to .env.aws.prod (git-ignored) and fill in real values, then run:
#   ./scripts/aws/set-secrets.sh
#
# FRONTEND_URL / WEB_URL / NEXT_PUBLIC_API_URL depend on the Elastic IP —
# run `terraform output public_ip` first (infra/aws/) and fill those in
# using that address, e.g. http://51.x.x.x:3000 / http://51.x.x.x:3001.

DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-access-token

DB_USER=permis2_0
DB_PASSWORD=changeme-generate-a-long-random-value
DB_NAME=permis2_0

JWT_SECRET=changeme-generate-a-long-random-value
JWT_EXPIRATION=24h

FRONTEND_URL=http://CHANGEME:3000
WEB_URL=http://CHANGEME:3000
NEXT_PUBLIC_API_URL=http://CHANGEME:3001

TERMII_API_KEY=
TERMII_SENDER_ID=PERMIS

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@permis2.com

PAYMENT_LIVE=false
BICTORYS_API_URL=https://api.bictorys.com
BICTORYS_API_KEY=
BICTORYS_SECRET_KEY=
PAYMENT_COUNTRY=SN
